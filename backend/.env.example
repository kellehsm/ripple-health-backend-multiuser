# Postgres connection
DATABASE_URL=postgres://wellness_user:changeme@localhost:5432/wellness

# Server
PORT=4000
NODE_ENV=development

# Auth
JWT_SECRET=change-me-to-a-long-random-secret
ADMIN_SECRET=change-me-admin-secret

# Credential encryption (AES-256-GCM key for stored OAuth tokens / passwords)
# Required in production — startup will exit(1) if absent when NODE_ENV=production
CRED_ENCRYPTION_KEY=change-me-32-byte-hex-or-base64-key

# Demo mode (set to "true" to enable shortcut demo login)
DEMO_LOGIN_ENABLED=false
DEMO_PASSWORD=

# AI / Chat
ANTHROPIC_API_KEY=

# Food / nutrition databases
PASSIO_API_KEY=
USDA_FDC_API_KEY=

# Books
HARDCOVER_API_KEY=

# Plaid (financial data)
PLAID_CLIENT_ID=
PLAID_SANDBOX_SECRET=
PLAID_PRODUCTION_SECRET=
PLAID_ENV=sandbox
PLAID_ANDROID_PACKAGE_NAME=com.example.wellness

# Google OAuth + Drive backup
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/auth/google/callback

# Dexcom OAuth (API v3)
DEXCOM_CLIENT_ID=
DEXCOM_CLIENT_SECRET=
DEXCOM_REDIRECT_URI=http://localhost:4000/auth/dexcom/callback
DEXCOM_API_BASE=https://sandbox-api.dexcom.com

# Dexcom Share (follower / read-only stream)
DEXCOM_SHARE_ACCOUNT_ID=
DEXCOM_SHARE_ACCOUNT_NAME=
DEXCOM_SHARE_PASSWORD=
DEXCOM_SHARE_REGION=us
# Set to "1" or "true" to disable the Dexcom Share polling cron
DEXCOM_SHARE_DISABLED=

# Internal service base URL (used by jobs/webhooks that need to call back into the API)
API_BASE_URL=http://localhost:4000
