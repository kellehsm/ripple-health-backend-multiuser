<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/ripple_widget_bg"
    android:padding="12dp">

    <!-- Header: logo + branding + score + timestamp + refresh -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="8dp">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/ripple_logo"
            android:contentDescription="Ripple Wellness"
            android:layout_marginRight="6dp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Ripple Wellness"
            android:textSize="13sp"
            android:textColor="@color/widget_text_primary"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_score"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="● --"
            android:textSize="13sp"
            android:textColor="@color/widget_text_muted"
            android:textStyle="bold"
            android:layout_marginRight="6dp"
            android:padding="2dp" />

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Tap ↻ to refresh"
            android:textSize="9sp"
            android:textColor="@color/widget_text_muted" />

        <TextView
            android:id="@+id/btn_refresh"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="  ↻"
            android:textSize="16sp"
            android:textColor="@color/widget_accent_teal"
            android:padding="4dp" />

    </LinearLayout>

    <!-- Row 1: Glucose | Steps | Heart rate -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/block_glucose"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/ripple_chip_berry"
            android:padding="7dp"
            android:layout_marginRight="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="GLUCOSE"
                android:textSize="8sp"
                android:textColor="@color/widget_berry_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_glucose"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="18sp"
                android:textColor="@color/widget_berry_value"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="mg/dL"
                android:textSize="8sp"
                android:textColor="@color/widget_berry_sub"
                android:layout_marginTop="1dp" />

            <ImageView
                android:id="@+id/widget_glucose_trend"
                android:layout_width="120dp"
                android:layout_height="36dp"
                android:scaleType="fitXY"
                android:layout_marginTop="2dp"
                android:visibility="gone"
                android:contentDescription="glucose trend" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/block_steps"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/ripple_chip_teal"
            android:padding="7dp"
            android:layout_marginRight="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="STEPS"
                android:textSize="8sp"
                android:textColor="@color/widget_teal_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_steps"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="18sp"
                android:textColor="@color/widget_teal_value"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="today"
                android:textSize="8sp"
                android:textColor="@color/widget_teal_sub"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/block_heart"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/ripple_chip_red"
            android:padding="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="HEART"
                android:textSize="8sp"
                android:textColor="@color/widget_red_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_heart"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="18sp"
                android:textColor="@color/widget_red_value"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="bpm"
                android:textSize="8sp"
                android:textColor="@color/widget_red_sub"
                android:layout_marginTop="1dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Row 2: Water (with + button) | Sleep | Meals -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginTop="6dp">

        <LinearLayout
            android:id="@+id/block_water"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/ripple_chip_blue"
            android:paddingLeft="7dp"
            android:paddingRight="4dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:layout_marginRight="5dp">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="💧 WATER"
                    android:textSize="8sp"
                    android:textColor="@color/widget_blue_label"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/widget_water"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="--"
                    android:textSize="16sp"
                    android:textColor="@color/widget_blue_value"
                    android:textStyle="bold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="glasses"
                    android:textSize="8sp"
                    android:textColor="@color/widget_blue_sub"
                    android:layout_marginTop="1dp" />

            </LinearLayout>

            <TextView
                android:id="@+id/btn_water_plus"
                android:layout_width="30dp"
                android:layout_height="30dp"
                android:text="+"
                android:textSize="18sp"
                android:textColor="@color/widget_on_btn"
                android:textStyle="bold"
                android:gravity="center"
                android:background="@drawable/ripple_btn_blue_round" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/block_sleep"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/ripple_chip_sleep"
            android:padding="7dp"
            android:layout_marginRight="5dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🌙 SLEEP"
                android:textSize="8sp"
                android:textColor="@color/widget_sleep_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_sleep"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="18sp"
                android:textColor="@color/widget_sleep_value"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="last night"
                android:textSize="8sp"
                android:textColor="@color/widget_sleep_sub"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/block_meal"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:background="@drawable/ripple_chip_coral"
            android:padding="7dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🍜 MEALS"
                android:textSize="8sp"
                android:textColor="@color/widget_coral_label"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Log"
                android:textSize="14sp"
                android:textColor="@color/widget_coral_value"
                android:textStyle="bold"
                android:layout_marginTop="2dp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="open →"
                android:textSize="8sp"
                android:textColor="@color/widget_coral_sub"
                android:layout_marginTop="1dp" />

        </LinearLayout>

    </LinearLayout>

    <!-- Row 3: Mood quick-log + Insight carousel -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginTop="6dp">

        <!-- Mood quick-log: two emoji tap targets -->
        <TextView
            android:id="@+id/btn_mood_good"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="🙂"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginRight="2dp" />

        <TextView
            android:id="@+id/btn_mood_low"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:text="😕"
            android:textSize="18sp"
            android:gravity="center"
            android:layout_marginRight="4dp" />

        <!-- Insight carousel -->
        <LinearLayout
            android:id="@+id/block_insight"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:background="@drawable/ripple_chip_violet"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="8dp"
            android:paddingBottom="8dp">

            <ViewFlipper
                android:id="@+id/insight_flipper"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:autoStart="true"
                android:flipInterval="7000"
                android:inAnimation="@android:anim/fade_in"
                android:outAnimation="@android:anim/fade_out"
                android:measureAllChildren="true" />

            <TextView
                android:id="@+id/btn_insight_next"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="›"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="@color/widget_violet_accent"
                android:paddingLeft="10dp"
                android:paddingRight="4dp"
                android:paddingTop="2dp"
                android:paddingBottom="2dp" />

        </LinearLayout>

    </LinearLayout>

</LinearLayout>
