<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="horizontal"
    android:background="@drawable/ripple_widget_bg"
    android:padding="8dp">

    <LinearLayout
        android:id="@+id/block_glucose"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@drawable/ripple_chip_berry"
        android:padding="8dp"
        android:layout_marginRight="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="GLUCOSE"
            android:textSize="8sp"
            android:textColor="@color/widget_berry_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_glucose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="18sp"
            android:textColor="@color/widget_berry_value"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="mg/dL"
            android:textSize="8sp"
            android:textColor="@color/widget_berry_sub"
            android:layout_marginTop="1dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/block_steps"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="vertical"
        android:gravity="center_vertical"
        android:background="@drawable/ripple_chip_teal"
        android:padding="8dp"
        android:layout_marginRight="5dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="STEPS"
            android:textSize="8sp"
            android:textColor="@color/widget_teal_label"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_steps"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="--"
            android:textSize="18sp"
            android:textColor="@color/widget_teal_value"
            android:textStyle="bold" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="today"
            android:textSize="8sp"
            android:textColor="@color/widget_teal_sub"
            android:layout_marginTop="1dp" />

    </LinearLayout>

    <LinearLayout
        android:id="@+id/block_water"
        android:layout_width="0dp"
        android:layout_height="match_parent"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@drawable/ripple_chip_blue"
        android:paddingLeft="8dp"
        android:paddingRight="6dp"
        android:paddingTop="6dp"
        android:paddingBottom="6dp">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="WATER"
                android:textSize="8sp"
                android:textColor="@color/widget_blue_label"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/widget_water"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="18sp"
                android:textColor="@color/widget_blue_value"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="glasses"
                android:textSize="8sp"
                android:textColor="@color/widget_blue_sub"
                android:layout_marginTop="1dp" />

        </LinearLayout>

        <TextView
            android:id="@+id/btn_water_plus"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:text="+"
            android:textSize="18sp"
            android:textColor="@color/widget_on_btn"
            android:textStyle="bold"
            android:gravity="center"
            android:background="@drawable/ripple_btn_blue_round" />

    </LinearLayout>

</LinearLayout>
