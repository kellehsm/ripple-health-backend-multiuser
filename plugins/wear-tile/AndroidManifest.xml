<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.type.watch" />
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <application
        android:allowBackup="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/wear_app_name"
        android:supportsRtl="true"
        android:theme="@android:style/Theme.DeviceDefault">

        <!-- Marks this APK as a stand-alone (or paired) Wear OS app -->
        <meta-data
            android:name="com.google.android.wearable.standalone"
            android:value="true" />

        <!-- Minimal launcher activity — appears in the app drawer -->
        <activity
            android:name=".RippleWearMainActivity"
            android:exported="true"
            android:label="@string/wear_app_name"
            android:theme="@android:style/Theme.DeviceDefault">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Log activity: water + mood pills, launched from the Log tile -->
        <activity
            android:name=".RippleWearLogActivity"
            android:exported="true"
            android:label="@string/wear_app_name"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- Breathing session — pace picker then guided circle -->
        <activity
            android:name=".RippleWearBreathingActivity"
            android:exported="true"
            android:label="@string/wear_app_name"
            android:theme="@android:style/Theme.DeviceDefault" />

        <!-- ── Tiles: the user can add any of the three faces individually ── -->
        <service
            android:name=".RippleWearTileService"
            android:exported="true"
            android:label="@string/wear_tile_name"
            android:icon="@drawable/tile_icon"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <service
            android:name=".RippleWearLogTileService"
            android:exported="true"
            android:label="@string/wear_tile_log_name"
            android:icon="@drawable/tile_icon"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <service
            android:name=".RippleWearBreatheTileService"
            android:exported="true"
            android:label="@string/wear_tile_breathe_name"
            android:icon="@drawable/tile_icon"
            android:permission="com.google.android.wearable.permission.BIND_TILE_PROVIDER">
            <intent-filter>
                <action android:name="androidx.wear.tiles.action.BIND_TILE_PROVIDER" />
            </intent-filter>
            <meta-data
                android:name="androidx.wear.tiles.PREVIEW"
                android:resource="@drawable/tile_preview" />
        </service>

        <!-- Receives glucose/steps/water DataItems pushed from the phone -->
        <service
            android:name=".WearDataListenerService"
            android:exported="true">
            <intent-filter>
                <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
                <data android:scheme="wear" android:host="*" android:pathPrefix="/ripple/metrics" />
            </intent-filter>
        </service>

    </application>
</manifest>
