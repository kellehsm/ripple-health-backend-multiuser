package __PACKAGE__

import android.content.Context
import android.util.Log
import com.google.android.gms.wearable.PutDataMapRequest
import com.google.android.gms.wearable.Wearable
import java.time.LocalTime
import java.time.format.DateTimeFormatter

/**
 * Pushes the latest widget metrics onto the Wearable Data Layer so paired
 * Wear OS devices can render them in the Ripple tile.
 *
 * Safe to call from any thread — it fires and forgets. Any exception (no
 * Wear OS device paired, Google Play Services missing, etc.) is swallowed.
 */
object WearDataBridge {
    private const val PATH = "/ripple/metrics"
    private const val TAG = "WearDataBridge"

    /** Small helper: after handling a watch-initiated log, phone-side code
     *  broadcasts just the status flip so the Log tile flashes ✓ or ✗ for
     *  the user. Uses the same Data Layer path so the wear listener picks
     *  it up alongside metric pushes. */
    fun pushLogResult(context: Context, ok: Boolean) {
        try {
            val req = PutDataMapRequest.create(PATH).apply {
                dataMap.putString("lastLogStatus", if (ok) "ok" else "fail")
                dataMap.putLong("lastLogStatusAt", System.currentTimeMillis())
                dataMap.putLong("nonce", System.currentTimeMillis())
            }
            Wearable.getDataClient(context.applicationContext)
                .putDataItem(req.asPutDataRequest().setUrgent())
                .addOnFailureListener { e -> Log.w(TAG, "pushLogResult failed", e) }
        } catch (e: Exception) {
            Log.w(TAG, "pushLogResult threw", e)
        }
    }

    /**
     * Push metrics to the watch. Glucose is passed as the raw mg/dL string
     * (no arrow embedded); the arrow/label/trend/delta/stale flags are pushed
     * as separate fields so the tile can render the color-coded state
     * (red when high-and-rising, low-and-falling, etc.) and the "STALE 32M"
     * treatment for aged readings.
     */
    fun push(
        context: Context,
        glucose: String,
        steps: String,
        water: String,
        heart: String = "--",
        sleep: String = "--",
        insight: String = "",
        glucoseArrow: String = "",
        glucoseLabel: String = "",
        glucoseTrend: String = "",
        glucoseDelta: Int = 0,
        glucoseStale: Boolean = false,
        mindStreak: Int = 0,
        lastLogStatus: String = "",
        lastLogStatusAt: Long = 0L,
        wellnessScore: String = "--"
    ) {
        try {
            val time = LocalTime.now().format(DateTimeFormatter.ofPattern("h:mm a"))
            val req = PutDataMapRequest.create(PATH).apply {
                dataMap.putString("glucose", glucose)
                dataMap.putString("glucoseArrow", glucoseArrow)
                dataMap.putString("glucoseLabel", glucoseLabel)
                dataMap.putString("glucoseTrend", glucoseTrend)
                dataMap.putInt("glucoseDelta", glucoseDelta)
                dataMap.putBoolean("glucoseStale", glucoseStale)
                dataMap.putInt("mindStreak", mindStreak)
                dataMap.putString("lastLogStatus", lastLogStatus)
                dataMap.putLong("lastLogStatusAt", lastLogStatusAt)
                dataMap.putString("steps", steps)
                dataMap.putString("water", water)
                dataMap.putString("heart", heart)
                dataMap.putString("sleep", sleep)
                dataMap.putString("insight", insight)
                dataMap.putString("wellnessScore", wellnessScore)
                dataMap.putString("updatedAt", time)
                // Include a nonce so DataItem changes even if values are unchanged,
                // guaranteeing the watch listener fires and refreshes the tile timestamp
                dataMap.putLong("nonce", System.currentTimeMillis())
            }
            Wearable.getDataClient(context.applicationContext)
                .putDataItem(req.asPutDataRequest().setUrgent())
                .addOnFailureListener { e -> Log.w(TAG, "push failed", e) }
        } catch (e: Exception) {
            Log.w(TAG, "push threw", e)
        }
    }
}
